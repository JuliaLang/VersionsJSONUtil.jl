{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBinPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::julialang2",
      "Condition": {
        "StringLike": { "s3:prefix": "bin/*" }
      }
    },
    {
      "Sid": "ReadBinaries",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::julialang2/bin/*"
    }
  ]
}
